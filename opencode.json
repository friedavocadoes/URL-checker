{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "watcher": {
    "ignore": [
      ".venv/**",
      "__pycache__/**",
      "*.pyc",
      "*.zip",
      "web-ext-artifacts/**"
    ]
  },
  "formatter": false,
  "lsp": false,
  "permission": {
    "bash": {
      "git *": "allow",
      "python -m py_compile *": "allow",
      "python -c *": "allow",
      "python main.py": "ask",
      "python3 *": "allow",
      "pip *": "allow",
      "pytest*": "allow",
      "jq *": "allow",
      "node --check *": "allow",
      "Compress-Archive *": "allow",
      "zip *": "allow",
      "unzip *": "allow",
      "*": "ask"
    },
    "edit": "allow",
    "external_directory": "allow"
  }
}
